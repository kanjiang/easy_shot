{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": [
    "entry/src/main/ets/**/*.ts",
    "entry/src/main/ets/**/*.ets"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
